---
import { withBase } from '../lib/withBase';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<img
  class={className}
  src={withBase('images/logos/rabbitHoleAppsLogos_RabbitHoleApps-WhiteLogo.png')}
  alt=""
  width="48"
  height="48"
  decoding="async"
  aria-hidden="true"
/>
