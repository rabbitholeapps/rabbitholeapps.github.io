---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  placeholder?: boolean;
  lightboxIndex?: number;
}

const { src, alt, caption, placeholder = false, lightboxIndex } = Astro.props;
const canLightbox = !placeholder && lightboxIndex !== undefined;
---

<figure class="shot">
  {
    canLightbox ? (
      <button
        type="button"
        class="shot__trigger"
        data-lightbox-index={lightboxIndex}
        aria-label={`View larger: ${alt}`}
      >
        <div class="phone">
          <img class="phone__screen" src={src} alt={alt} loading="lazy" width="390" height="844" />
        </div>
      </button>
    ) : (
      <div class:list={['phone', placeholder && 'phone--placeholder']}>
        <img class="phone__screen" src={src} alt={alt} loading="lazy" width="390" height="844" />
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>
