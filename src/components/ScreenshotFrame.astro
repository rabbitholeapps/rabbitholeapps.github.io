---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  placeholder?: boolean;
  presentation?: 'device' | 'artwork';
  lightboxIndex?: number;
}

const {
  src,
  alt,
  caption,
  placeholder = false,
  presentation = 'device',
  lightboxIndex,
} = Astro.props;
const canLightbox = !placeholder && lightboxIndex !== undefined;
const isArtwork = presentation === 'artwork';
---

<figure class="shot">
  {
    canLightbox ? (
      <button
        type="button"
        class="shot__trigger"
        data-lightbox-index={lightboxIndex}
        aria-label={`View larger: ${alt}`}
      >
        <div class:list={['phone', isArtwork && 'phone--artwork']}>
          <img
            class="phone__screen"
            src={src}
            alt={alt}
            loading="lazy"
            width={isArtwork ? 1080 : 390}
            height={isArtwork ? 1920 : 844}
          />
        </div>
      </button>
    ) : (
      <div
        class:list={[
          'phone',
          placeholder && 'phone--placeholder',
          isArtwork && 'phone--artwork',
        ]}
      >
        <img
          class="phone__screen"
          src={src}
          alt={alt}
          loading="lazy"
          width={isArtwork ? 1080 : 390}
          height={isArtwork ? 1920 : 844}
        />
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>
