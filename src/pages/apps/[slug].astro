---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScreenshotGallery from '../../components/ScreenshotGallery.astro';
import AppDocNav from '../../components/AppDocNav.astro';
import AppToc from '../../components/AppToc.astro';
import { withBase } from '../../lib/withBase';
import { isExternalHref, externalAttrs } from '../../lib/external';
import { markdownH2s } from '../../lib/slug';
import { partitionCtas, storeBadge } from '../../lib/storeLinks';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({
    params: { slug: app.id },
    props: { app },
  }));
}

const { app } = Astro.props;
const {
  name,
  tagline,
  status,
  labels,
  problem,
  solution,
  highlights,
  cta,
  extraLinks,
  setup,
  github,
  logo,
  screenshots,
  screenshotGroups,
} = app.data;
const { Content } = await render(app);
const hasBody = Boolean(app.body?.trim());
const docs = (await getCollection('appDocs'))
  .filter((doc) => doc.data.app === app.id)
  .sort((a, b) => a.data.order - b.data.order)
  .map((doc) => ({ page: doc.data.page, navLabel: doc.data.navLabel }));

const groups = screenshotGroups?.length
  ? screenshotGroups
  : [{ heading: 'In the app', id: 'in-the-app', shots: screenshots }];

const toc = [
  { id: 'problem', label: 'Problem' },
  { id: 'solution', label: 'Solution' },
  ...markdownH2s(app.body ?? ''),
  ...(setup ? [{ id: 'get-set-up', label: 'Get set up' }] : []),
  { id: 'get-the-app', label: 'Get the app' },
  ...groups.map((group) => ({ id: group.id, label: group.heading })),
  ...(docs.length ? [{ id: 'privacy-and-support', label: 'Privacy and support' }] : []),
];

const { store, rest } = partitionCtas([cta, ...extraLinks]);

function hrefFor(href: string) {
  if (isExternalHref(href) || href.startsWith('mailto:')) return href;
  return withBase(href);
}
---

<BaseLayout title={name} description={tagline}>
  <AppToc items={toc} />
  <article class="wrap app-page">
    <div class="app-page-hero">
      <a class="back" href={withBase('apps/')}>← All apps</a>
      <div class="app-page-hero__brand">
        <img class="app-page-hero__logo" src={withBase(logo)} alt="" width="68" height="68" />
        <div class="app-page-hero__copy">
          <div class="badge-row">
            <span class:list={['badge', status === 'Live' && 'badge--live']}>{status}</span>
            {labels.map((label) => (
              <span class="badge badge--accent">{label}</span>
            ))}
          </div>
          <h1>{name}</h1>
          <p class="lede">{tagline}</p>
        </div>
      </div>
    </div>

    <div class="prose-pair">
      <section class="prose-block" id="problem">
        <h2>Problem</h2>
        <p>{problem}</p>
      </section>
      <section class="prose-block" id="solution">
        <h2>Solution</h2>
        <p>{solution}</p>
      </section>
    </div>

    <ul class="highlights">
      {highlights.map((item) => <li>{item}</li>)}
    </ul>

    {
      hasBody && (
        <div class="app-body">
          <Content />
        </div>
      )
    }

    {
      setup && (
        <aside class="callout" id="get-set-up">
          <h2>Get set up</h2>
          <p>{setup}</p>
        </aside>
      )
    }

    <div class="cta-row" id="get-the-app">
      {
        store.length > 0 && (
          <div class="store-badges">
            {store.map((item) => {
              const badge = storeBadge(item.kind);
              return (
                <a
                  class="store-badge"
                  href={item.href}
                  aria-label={badge.alt}
                  {...externalAttrs(item.href)}
                >
                  <img src={withBase(badge.src)} alt="" height="52" />
                </a>
              );
            })}
          </div>
        )
      }
      {
        rest.map((link, index) => (
          <a
            class:list={['cta', (store.length > 0 || index > 0) && 'cta--ghost']}
            href={hrefFor(link.href)}
            {...externalAttrs(link.href)}
          >
            {link.label}
          </a>
        ))
      }
      {
        github && (
          <a class="cta cta--ghost" href={hrefFor(github)} {...externalAttrs(github)}>
            View source on GitHub
          </a>
        )
      }
    </div>

    <ScreenshotGallery groups={groups} />

    {
      docs.length > 0 && (
        <div id="privacy-and-support">
          <AppDocNav appSlug={app.id} appName={name} docs={docs} />
        </div>
      )
    }
  </article>
</BaseLayout>
