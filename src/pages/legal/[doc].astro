---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/withBase';

export async function getStaticPaths() {
  const docs = await getCollection('legal');
  return docs.map((entry) => ({
    params: { doc: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const siblings = (await getCollection('legal'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((doc) => ({ id: doc.id, navLabel: doc.data.navLabel }));
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="wrap doc-page">
    <nav class="doc-nav" aria-label="Legal documents">
      <a class="back" href={withBase('legal/')}>← Legal</a>
      <div class="doc-nav__links">
        {
          siblings.map((doc) => (
            <a
              href={withBase(`legal/${doc.id}/`)}
              aria-current={doc.id === entry.id ? 'page' : undefined}
            >
              {doc.navLabel}
            </a>
          ))
        }
      </div>
    </nav>
    <div class="app-body legal-body">
      <Content />
    </div>
  </article>
</BaseLayout>
